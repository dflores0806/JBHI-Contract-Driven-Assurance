{
  "knowledge_version": "methodology-v1",
  "rules": [
    {
      "id": "LU-H001",
      "type": "hard",
      "category": "safety_constraint",
      "condition": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "field": "learner_management",
            "value": "observe"
          },
          {
            "op": "neq",
            "field": "expected_diagnosis",
            "value": "normal"
          }
        ]
      },
      "consequence": {
        "output_policy": "blocked",
        "reason": "under_treatment_risk",
        "tag": "Under-treatment risk"
      },
      "priority": 1,
      "version": "methodology-v1",
      "provenance": {
        "type": "implementation_derived_extension",
        "source": "LungTwinMentor.html",
        "source_behavior": "existing under-treatment risk tag",
        "methodology_change": "promoted to non-overridable management-pathway block"
      },
      "references": [
        "learner_management",
        "expected_diagnosis"
      ],
      "unknown_applicable": true
    },
